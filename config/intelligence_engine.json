  "learning_engine": {
    "horizon_sessions": 5,
    "purging_window_calendar_days": 5,
    "embargo_calendar_days": 2,
    "neutral_band_pct": 1.0,
    "asymmetric_reward": {
      "win_return_threshold_pct": 2.0,
      "win_max_drawdown_threshold_pct": 1.5,
      "loss_max_drawdown_threshold_pct": 3.0,
      "win_reward": 1.0,
      "loss_penalty": -1.5,
      "scratch_reward": 0.0
