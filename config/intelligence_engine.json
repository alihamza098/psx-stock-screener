  "stage6_self_learning_guardrails": {
    "enabled": true,
    "max_relative_weight_change": 0.10,
    "min_absolute_weight_change_floor": 0.02,
    "held_out_validation_split": 0.30,
    "max_held_out_brier_degradation_pct": 15.0,
    "auto_abort_on_severe_degradation": true,
    "default_weights_version": "W_v1.0.0",
    "default_pattern_version": "P_v1.0.0"
  }
