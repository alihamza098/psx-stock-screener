    "kelly_sizing": {
      "fraction": 0.25,
      "default_capital_pkr": 500000.0,
      "max_risk_per_idea_pct": 1.0,
      "max_aggregate_risk_pct": 6.0,
      "regime_sizing_multipliers": {
        "BULL": 1.0,
        "NEUTRAL": 1.0,
        "BEAR": 0.70,
        "CRASH": 0.40
      }
    },
    "circuit_proximity_threshold_pct": 1.0
