    "rsi_jump_threshold": 3.0,
    "sector_momentum_pct_threshold": 1.5,
    "market_momentum_pct_threshold": 1.0
  },
  "prediction_engine": {
    "prior_weight_alpha": 5.0,
    "prior_weight_beta": 20.0,
    "min_sample_size_platt": 30,
    "max_calibration_adj_points": 15
