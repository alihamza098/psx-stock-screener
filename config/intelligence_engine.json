      "VOLUME_ACCUMULATION": 0.25,
      "SECTOR_MOMENTUM": 0.15,
      "CORPORATE_ANNOUNCEMENT": 0.15,
      "MARKET_MOMENTUM": 0.10
    },
    "max_momentum_secondary_bonus": 10.0,
    "regularization_l2": 0.001
