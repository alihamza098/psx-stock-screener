  },
  "stage5_suggested_shares": {
    "enabled": true,
    "max_list_size": 10,
    "max_ideas_per_sector": 2,
    "min_composite_score": 45.0,
    "reorder_score_delta_threshold": 2.0,
    "horizon_sessions": 5,
    "liquidity_floor": {
