{
  "description": "Configuration for Today's Opportunities (Same-Day Trade Scanner)",
  "version": "1.0",
  "enabled": true,
  "tiers": {
    "steady": {
      "name": "Steady",
      "target_pct": 3.0,
      "min_rr": 1.5,
      "rvol_min": 1.0,
      "rvol_max": 1.5,
      "atr_pct_max": 2.5,
      "stop_atr_mult": 1.2,
      "target_atr_mult": 1.5
    },
    "active": {
      "name": "Active",
      "target_pct": 5.0,
      "min_rr": 1.8,
      "rvol_min": 1.5,
      "rvol_max": 3.0,
      "atr_pct_min": 2.5,
      "atr_pct_max": 4.5,
      "stop_atr_mult": 1.5,
      "target_atr_mult": 2.2
    },
    "momentum": {
      "name": "Momentum",
      "target_pct": 8.0,
      "min_rr": 2.0,
      "rvol_min": 3.0,
      "atr_pct_min": 4.0,
      "stop_atr_mult": 2.0,
