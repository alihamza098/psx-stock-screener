      "min_gap_pct": 1.5,
      "max_gap_pct": 5.5,
      "holding_minutes_required": 15,
      "volume_confirmation_mult": 1.3
    },
    "vwap_reclaim": {
      "enabled": true,
      "max_pullback_from_vwap_pct": 0.8,
      "stop_buffer_below_vwap_pct": 0.5,
      "require_rising_vwap": true
    },
    "circuit_runner": {
      "enabled": true,
      "min_rvol": 2.5,
      "near_circuit_pct": 5.5,
      "stop_atr_mult": 2.0
    },
    "oversold_bounce": {
      "enabled": true,
      "rsi_period": 14,
      "rsi_oversold_threshold": 32.0,
      "pivot_proximity_pct": 0.8,
      "stop_buffer_below_support_pct": 0.5
    }
  },
  "lifecycle": {
    "watch_expiry_mon_thu": "13:30",
    "watch_expiry_friday_s1": "11:30",
    "watch_expiry_friday_s2": "15:30",
    "time_exit_minutes_before_close": 15,
    "allow_hold_through_jummah_break": true,
